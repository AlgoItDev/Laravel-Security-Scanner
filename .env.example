# Laravel Security Scanner — Environment Configuration
# Copy this file to .env and customise

APP_NAME="Laravel Security Scanner"
APP_VERSION="1.0.0"
DEBUG=false

# Scanner behaviour
SCAN_TIMEOUT=10
MAX_REDIRECTS=3
CONCURRENT_CHECKS=5
USER_AGENT="Mozilla/5.0 (compatible; LaravelSecScanner/1.0)"

# Output
REPORT_OUTPUT_DIR=reports
LOG_LEVEL=INFO
LOG_DIR=logs
